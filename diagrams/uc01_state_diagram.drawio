<mxfile host="app.diagrams.net" modified="2026-10-21T18:22:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="uc01-state" name="UC-01 State Machine Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="UC-01: Chapter Entity &amp; Lifecycle — State Machine Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Initial Pseudo-State -->
        <mxCell id="init" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="535" y="80" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- State 1: DRAFT -->
        <mxCell id="st_draft" value="DRAFT / ENTERING TITLE&#xa;---------------------------------------&#xa;entry / Display modal input dialog&#xa;do / Admin types title in RTL text field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="Admin clicks 'نیا باب (New Chapter)'" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="init" target="st_draft">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- State 2: VALIDATING -->
        <mxCell id="st_validating" value="VALIDATING&#xa;---------------------------------------&#xa;do / Check length(trim(title)) &gt; 0&#xa;do / Generate UUID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="270" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="t2" value="Admin clicks OK" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="st_draft" target="st_validating">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Validation Failure Loopback -->
        <mxCell id="t_fail" value="[BR-01: title is null or blank] /&#xa;showError('باب کا عنوان خالی نہیں ہو سکتا')" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;endArrow=block;rounded=1;strokeColor=#B85450;fontStyle=1;fontColor=#B85450;fontSize=10;" edge="1" parent="1" source="st_validating" target="st_draft">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="305"/>
              <mxPoint x="750" y="185"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 3: PERSISTED & IDLE IN LIST -->
        <mxCell id="st_idle" value="PERSISTED &amp; IDLE IN LIST&#xa;---------------------------------------&#xa;entry / Saved in MySQL chapters table&#xa;entry / Shown in JList (oldest-first)&#xa;status / 'کل ابواب: N'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="390" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="t3" value="[Title is valid] /&#xa;insert(chapter) &amp; refreshList()" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#2E7D32;fontStyle=1;fontSize=11;" edge="1" parent="1" source="st_validating" target="st_idle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- State 4: SELECTED -->
        <mxCell id="st_selected" value="SELECTED IN LIST&#xa;---------------------------------------&#xa;entry / Row highlighted&#xa;entry / Admin can Rename or Delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="520" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t4" value="Admin selects chapter in JList" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="st_idle" target="st_selected">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="t_unselect" value="Selection cleared" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;endArrow=block;rounded=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="st_selected" target="st_idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="540"/>
              <mxPoint x="360" y="440"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 5: RENAMING -->
        <mxCell id="st_renaming" value="RENAMING (FR-CH-05)&#xa;---------------------------------------&#xa;entry / Show dialog with pre-filled title&#xa;do / Admin modifies title&#xa;exit / Validate non-blank (BR-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="515" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="t_rename" value="Admin clicks 'نام تبدیل کریں'" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="st_selected" target="st_renaming">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="t_rename_ok" value="[Valid new title] /&#xa;updateTitle() in MySQL" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;endArrow=block;rounded=1;strokeColor=#2E7D32;fontStyle=1;fontSize=10;" edge="1" parent="1" source="st_renaming" target="st_idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="420"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t_rename_cancel" value="[Blank new title or Cancel] /&#xa;Title unchanged (BR-06)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#B85450;dashed=1;fontSize=10;" edge="1" parent="1" source="st_renaming" target="st_selected">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="230" y="565" as="sourcePoint"/>
            <mxPoint x="425" y="565" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- State 6: CONFIRMING DELETE -->
        <mxCell id="st_confirm_del" value="CONFIRMING DELETE&#xa;---------------------------------------&#xa;entry / Show warning dialog (BR-04, BR-05)&#xa;message / Cascade warning (all components&#xa;and glossary entries will be purged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="640" width="270" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="t_delete_click" value="Admin clicks 'حذف کریں (Delete)'" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#B85450;fontStyle=1;fontSize=11;" edge="1" parent="1" source="st_selected" target="st_confirm_del">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="t_delete_cancel" value="Admin clicks 'نہیں، منسوخ کریں'" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;endArrow=block;rounded=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="st_confirm_del" target="st_selected">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="670"/>
              <mxPoint x="730" y="560"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State 7: PURGED / CASCADED -->
        <mxCell id="st_purged" value="PURGED &amp; REMOVED (FR-CH-07)&#xa;---------------------------------------&#xa;do / MySQL DELETE FROM chapters&#xa;do / ON DELETE CASCADE cleans components&#xa;exit / Removed from UI listModel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="780" width="270" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="t_delete_confirm" value="Admin clicks 'ہاں، حذف کریں'" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#B85450;fontStyle=1;fontSize=11;" edge="1" parent="1" source="st_confirm_del" target="st_purged">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Final State -->
        <mxCell id="end_state" value="" style="ellipse;shape=doubleEllipse;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="535" y="890" width="30" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="t_end" value="Removed from memory &amp; UI" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="st_purged" target="end_state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
